    <script>
        /* Audio Synthesizer (Zero External Dependencies) */
        class SoundSystem {
            constructor() {
                this.ctx = null;
            }

            init() {
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioCtx();
                }
            }

            playShoot() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(300, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(800, this.ctx.currentTime + 0.12);
                gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.12);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.12);
            }

            playSuccess() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, this.ctx.currentTime); // C5
                osc.frequency.setValueAtTime(659.25, this.ctx.currentTime + 0.08); // E5
                osc.frequency.setValueAtTime(783.99, this.ctx.currentTime + 0.16); // G5
                gain.gain.setValueAtTime(0.25, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.3);
            }

            playExtraLife() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, this.ctx.currentTime); // A4
                osc.frequency.setValueAtTime(880, this.ctx.currentTime + 0.1); // A5
                gain.gain.setValueAtTime(0.3, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.35);
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                osc.start();
                osc.stop(this.ctx.currentTime + 0.35);
            }

            playExplosion() {
                if (!this.ctx) return;
                const bufferSize = this.ctx.sampleRate * 0.3;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }

                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'lowpass';
                filter.frequency.setValueAtTime(800, this.ctx.currentTime);
                filter.frequency.linearRampToValueAtTime(50, this.ctx.currentTime + 0.3);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.5, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.3);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);

                noise.start();
                noise.stop(this.ctx.currentTime + 0.3);
            }
        }

        const audio = new SoundSystem();

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const gameContainer = document.getElementById('game-container');

        const overlay = document.getElementById('overlay');
        const overlayTitle = document.getElementById('overlay-title');
        const overlaySubtitle = document.getElementById('overlay-subtitle');
        const startBtn = document.getElementById('start-btn');

        const rulesModal = document.getElementById('rules-modal');
        const impressumModal = document.getElementById('impressum-modal');

        const highscoreEl = document.getElementById('highscore');
        const scoreEl = document.getElementById('current-score');
        const levelEl = document.getElementById('level-display');

        // State Variables
        let gameState = 'START'; // 'START', 'PLAYING', 'MOVING', 'EXPLODED', 'SUCCESS'
        let score = 0;
        let lives = 3;
        let highscore = parseInt(localStorage.getItem('gapshot_highscore') || '0', 10);
        highscoreEl.innerText = highscore;

        let particles = [];
        let successParticles = [];

        // Dynamic Canvas Sizing
        let width = 300;
        let height = 500;

        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;
            width = canvas.width;
            height = canvas.height;
            if (gameState === 'START' || gameState === 'PLAYING') {
                resetBallPosition();
                initLines();
            }
        }

        // Ball Config
        let ball = {
            x: 0,
            y: 0,
            radius: 10,
            speed: 13,
            color: '#06b6d4'
        };

        // Lines Config
        let lines = [];

        function initLines() {
            const gap1 = Math.max(65, 125 - Math.min(score, 20) * 2.5);
            const gap2 = Math.max(55, 105 - Math.min(score, 20) * 2.2);

            const speed1 = 1.4 + Math.min(score, 30) * 0.12;
            const speed2 = 1.8 + Math.min(score, 30) * 0.15;

            lines = [
                {
                    y: height * 0.58,
                    gapWidth: gap1,
                    x: Math.random() * (width - gap1),
                    speed: speed1,
                    dir: Math.random() < 0.5 ? 1 : -1,
                    color: '#f43f5e'
                },
                {
                    y: height * 0.32,
                    gapWidth: gap2,
                    x: Math.random() * (width - gap2),
                    speed: speed2,
                    dir: Math.random() < 0.5 ? 1 : -1,
                    color: '#a855f7'
                }
            ];
        }

        function resetBallPosition() {
            ball.x = width / 2;
            ball.y = height - 45;
        }

        function updateLivesUI() {
            for (let i = 1; i <= 3; i++) {
                const heart = document.getElementById(`heart-${i}`);
                if (i <= lives) {
                    heart.innerText = '❤️';
                    heart.classList.add('heart-active');
                    heart.style.opacity = '1';
                } else {
                    heart.innerText = '🖤';
                    heart.classList.remove('heart-active');
                    heart.style.opacity = '0.4';
                }
            }
        }

        function triggerAction() {
            // Prevent shooting if modals are open
            if (!rulesModal.classList.contains('hidden') || !impressumModal.classList.contains('hidden')) {
                return;
            }

            audio.init();

            if (gameState === 'START') {
                startGame();
            } else if (gameState === 'PLAYING') {
                gameState = 'MOVING';
                audio.playShoot();
            }
        }

        function startGame() {
            score = 0;
            lives = 3;
            updateLivesUI();
            scoreEl.innerText = score;
            levelEl.innerText = 1;
            overlay.classList.add('opacity-0', 'pointer-events-none');
            resetBallPosition();
            initLines();
            gameState = 'PLAYING';
        }

        function handleCrash() {
            gameState = 'EXPLODED';
            audio.playExplosion();
            
            // Screen Shake effect
            gameContainer.classList.remove('shake-screen');
            void gameContainer.offsetWidth; // Trigger reflow
            gameContainer.classList.add('shake-screen');

            // Spawn Particles
            createExplosionParticles(ball.x, ball.y);

            lives--;
            updateLivesUI();

            if (lives > 0) {
                // Still have lives left! Reset ball after short delay
                setTimeout(() => {
                    resetBallPosition();
                    gameState = 'PLAYING';
                }, 800);
            } else {
                // Out of lives -> Game Over
                if (score > highscore) {
                    highscore = score;
                    localStorage.setItem('gapshot_highscore', highscore);
                    highscoreEl.innerText = highscore;
                }

                setTimeout(() => {
                    overlayTitle.innerText = 'GAME OVER';
                    overlaySubtitle.innerHTML = `Du hast Level <span class="text-amber-400 font-bold">${Math.floor(score/3)+1}</span> mit <span class="text-cyan-400 font-bold">${score} Punkten</span> erreicht.`;
                    startBtn.innerText = 'ERNEUT VERSUCHEN';
                    overlay.classList.remove('opacity-0', 'pointer-events-none');
                    gameState = 'START';
                }, 900);
            }
        }

        function scorePoint() {
            gameState = 'SUCCESS';
            audio.playSuccess();
            createSuccessParticles(ball.x, ball.y);

            const oldLevel = Math.floor(score / 3) + 1;
            score++;
            const newLevel = Math.floor(score / 3) + 1;

            scoreEl.innerText = score;
            levelEl.innerText = newLevel;

            // Extra life on level up (capped at 3)
            if (newLevel > oldLevel && lives < 3) {
                lives++;
                updateLivesUI();
                audio.playExtraLife();

                // Show popup animation above hearts
                const popup = document.getElementById('extra-life-popup');
                if (popup) {
                    popup.classList.remove('opacity-0', '-translate-y-2');
                    popup.classList.add('opacity-100', '-translate-y-4');
                    setTimeout(() => {
                        popup.classList.remove('opacity-100', '-translate-y-4');
                        popup.classList.add('opacity-0', '-translate-y-2');
                    }, 1000);
                }
            }

            setTimeout(() => {
                resetBallPosition();
                initLines();
                gameState = 'PLAYING';
            }, 400);
        }

        function createExplosionParticles(x, y) {
            particles = [];
            for (let i = 0; i < 35; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                particles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    radius: Math.random() * 4 + 2,
                    color: Math.random() < 0.5 ? '#f43f5e' : '#fb923c',
                    alpha: 1
                });
            }
        }

        function createSuccessParticles(x, y) {
            successParticles = [];
            for (let i = 0; i < 25; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 4 + 1;
                successParticles.push({
                    x: x,
                    y: y,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 1,
                    radius: Math.random() * 3 + 2,
                    color: '#22c55e',
                    alpha: 1
                });
            }
        }

        function update() {
            // Move Lines
            if (gameState === 'PLAYING' || gameState === 'MOVING') {
                lines.forEach(line => {
                    line.x += line.speed * line.dir;
                    if (line.x <= 0) {
                        line.x = 0;
                        line.dir = 1;
                    } else if (line.x + line.gapWidth >= width) {
                        line.x = width - line.gapWidth;
                        line.dir = -1;
                    }
                });
            }

            // Move Ball
            if (gameState === 'MOVING') {
                ball.y -= ball.speed;

                // Check collision with lines
                lines.forEach(line => {
                    if (Math.abs(ball.y - line.y) <= ball.radius + 3) {
                        const gapStart = line.x;
                        const gapEnd = line.x + line.gapWidth;

                        if (ball.x - ball.radius < gapStart || ball.x + ball.radius > gapEnd) {
                            handleCrash();
                        }
                    }
                });

                // Top boundary reached safely
                if (ball.y <= 35 && gameState === 'MOVING') {
                    scorePoint();
                }
            }

            // Update Explosion Particles
            particles.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= 0.03;
            });
            particles = particles.filter(p => p.alpha > 0);

            // Update Success Particles
            successParticles.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                p.alpha -= 0.04;
            });
            successParticles = successParticles.filter(p => p.alpha > 0);
        }

        function draw() {
            ctx.clearRect(0, 0, width, height);

            // Draw Lines with Gap
            lines.forEach(line => {
                ctx.shadowBlur = 12;
                ctx.shadowColor = line.color;
                ctx.fillStyle = line.color;

                // Left Segment
                ctx.fillRect(0, line.y - 3, line.x, 6);
                // Right Segment
                ctx.fillRect(line.x + line.gapWidth, line.y - 3, width - (line.x + line.gapWidth), 6);

                // Subtle visual guide line across gap
                ctx.shadowBlur = 0;
                ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
                ctx.fillRect(line.x, line.y - 1, line.gapWidth, 2);
            });

            // Draw Ball
            if (gameState !== 'EXPLODED') {
                ctx.save();
                ctx.shadowBlur = 15;
                ctx.shadowColor = ball.color;
                ctx.fillStyle = gameState === 'SUCCESS' ? '#22c55e' : ball.color;
                ctx.beginPath();
                ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Draw Explosion Particles
            particles.forEach(p => {
                ctx.save();
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // Draw Success Particles
            successParticles.forEach(p => {
                ctx.save();
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });
        }

        function gameLoop() {
            update();
            draw();
            requestAnimationFrame(gameLoop);
        }

        // Modal Handlers
        function openModal(modal) {
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        function closeModal(modal) {
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        document.getElementById('open-rules-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            openModal(rulesModal);
        });

        document.getElementById('close-rules-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            closeModal(rulesModal);
        });

        document.getElementById('close-rules-bottom-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            closeModal(rulesModal);
        });

        document.getElementById('open-impressum-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            openModal(impressumModal);
        });

        document.getElementById('close-impressum-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            closeModal(impressumModal);
        });

        document.getElementById('close-impressum-bottom-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            closeModal(impressumModal);
        });

        window.addEventListener('resize', resizeCanvas);
        
        // Touch & Click Controls
        canvas.addEventListener('pointerdown', (e) => {
            e.preventDefault();
            triggerAction();
        });

        startBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            triggerAction();
        });

        window.addEventListener('keydown', (e) => {
            if (e.code === 'Space') {
                e.preventDefault();
                triggerAction();
            }
        });

        // Initialize canvas sizing and loop
        window.onload = () => {
            resizeCanvas();
            updateLivesUI();
            gameLoop();
        };
    </script>
</body>
</html>
